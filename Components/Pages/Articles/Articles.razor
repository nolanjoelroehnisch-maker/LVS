@*
    UI Design and Styling:
    The HTML/Razor markup structure and CSS styling were
    generated with AI assistance.
    The implementation was reviewed and integrated by me.
*@



@page "/articles"
@rendermode InteractiveServer

@using LVS.Models
@using LVS.Services
@using LVS.Components.Pages.Articles.Components

@inject ArticleService ArticleService
@inject IJSRuntime JS

<div class="lvs-page">

    <header class="topbar">
        <div class="brand">
            LVS
            <span>LOGISTICS MANAGEMENT SYSTEM</span>
        </div>

        <nav>
            <a href="/articles" class="nav-active">Articles</a>
            <a href="/warehouse">Warehouse</a>
            <a href="/storage-locations">Storage Locations</a>
            <a href="/system">System</a>
        </nav>

        <div class="user-info">
            Administrator
        </div>
    </header>

    
<section class="page-heading">
    <div>
        <h2>Article Master Data</h2>
        <span>Manage and monitor your article inventory</span>
    </div>

    <div class="heading-actions">
        <div class="article-count">
            Articles: <strong>@articles.Count</strong>
        </div>

        <button class="primary-button"
                @onclick="() => showArticleForm = true">
            + New Article
        </button>
    </div>
</section>

        @if (showArticleForm)
        {
            <section class="panel">
                <ArticleForm OnSave="CreateArticle"
                             OnCancel="() => showArticleForm = false" />
            </section>
        }

        


    <section class="panel">
        <div class="panel-heading">
            <strong>Search & Filter</strong>
        </div>

        <ArticleFilter SearchNumber="@searchNumber"
                       SearchNumberChanged="@(value => searchNumber = value)"
                       SearchName="@searchName"
                       SearchNameChanged="@(value => searchName = value)"
                       SearchBrand="@searchBrand"
                       SearchBrandChanged="@(value => searchBrand = value)"
                       SearchEAN="@searchEAN"
                       SearchEANChanged="@(value => searchEAN = value)"
                       StockFilter="@stockFilter"
                       StockFilterChanged="@(value => stockFilter = value)"
                       OnReset="ResetFilters" />
    </section>

    <section class="panel">
        <div class="panel-heading">
            <strong>Article Overview</strong>
            <span>@FilteredArticles.Count() results</span>
        </div>

        <ArticleTable Articles="FilteredArticles"
                      SelectedArticle="selectedArticle"
                      OnSelect="SelectArticle"
                      OnDelete="DeleteArticle" />
    </section>

    @if (selectedArticle is not null)
    {
        <section class="panel">
            <div class="panel-heading">
                <strong>Article Details</strong>
                <span>@selectedArticle.ArticleNumber</span>
            </div>

            <ArticleDetails SelectedArticle="selectedArticle" />
        </section>
    }

    <footer class="footer">
        <span>LVS - Logistics Management System</span>
        <span>Article Management</span>
    </footer>

</div>

@code {
    private List<Article> articles = new();
    private Article? selectedArticle;
    private bool showArticleForm = false;

    private string searchNumber = "";
    private string searchName = "";
    private string searchBrand = "";
    private string searchEAN = "";
    private string stockFilter = "All";

    private IEnumerable<Article> FilteredArticles =>
        articles.Where(article =>
            (string.IsNullOrWhiteSpace(searchNumber) ||
             article.ArticleNumber.Contains(searchNumber, StringComparison.OrdinalIgnoreCase)) &&

            (string.IsNullOrWhiteSpace(searchName) ||
             article.ArticleName.Contains(searchName, StringComparison.OrdinalIgnoreCase)) &&

            (string.IsNullOrWhiteSpace(searchBrand) ||
             article.Brand.Contains(searchBrand, StringComparison.OrdinalIgnoreCase)) &&

            (string.IsNullOrWhiteSpace(searchEAN) ||
             article.EAN.Contains(searchEAN, StringComparison.OrdinalIgnoreCase)) &&

            (stockFilter == "All" ||
             (stockFilter == "Low" && article.TotalStock <= article.MinimumStock) ||
             (stockFilter == "Available" && article.TotalStock > article.MinimumStock))
        );

    protected override async Task OnInitializedAsync()
    {
        articles = await ArticleService.GetAllAsync();
    }

    private void SelectArticle(Article article)
    {
        selectedArticle = article;
    }

    private void ResetFilters()
    {
        searchNumber = "";
        searchName = "";
        searchBrand = "";
        searchEAN = "";
        stockFilter = "All";
    }

    private async Task DeleteArticle(Article article)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Do you really want to delete article {article.ArticleNumber}?"
        );

        if (!confirmed)
            return;

        await ArticleService.DeleteAsync(article.Id);

        articles.Remove(article);

        if (selectedArticle?.Id == article.Id)
            selectedArticle = null;
    }

    private async Task CreateArticle(Article article)
    {
        Article createdArticle = await ArticleService.CreateAsync(article);

        articles.Add(createdArticle);
        selectedArticle = createdArticle;
        showArticleForm = false;
    }

}

